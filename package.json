{
  "name": "travelogia",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "dev": "npm run build:frontend && node backend/server.js",
    "start": "node backend/server.js",
    "lint": "npm run lint --workspace=frontend",
    "test": "vitest run",
    "test:backend": "vitest run backend/tests",
    "seed": "node backend/init/seed.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "vitest": "^5.1.2"
  }
}
